// The site is a Cloudflare Worker that only serves static files: everything in demo/.
// Deploy by hand from the repository root:
//   npx wrangler deploy
{
  "name": "tinygroove",
  "compatibility_date": "2026-11-01",
  "assets": { "directory": "./demo" },
  "routes": [{ "pattern": "tinygroove.com", "custom_domain": true }]
}
